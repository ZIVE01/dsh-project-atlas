{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/semantic-graph/export-allowlist.schema.json",
  "title": "Default-deny core export allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hashAlgorithm", "defaultPolicy", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "hashAlgorithm": { "const": "SHA-256" },
    "defaultPolicy": { "const": "deny" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "hashMode", "role", "license"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "hashMode": { "enum": ["bytes", "canonical-self-v1"] },
          "role": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
